# Providers Stremio consultados por defecto (TPB Adult queda catalog-only)
PROVIDERS=peerflix,torrentsdb,torrentio,piratebay

# URL base de Peerflix (por defecto https://peerflix.mov)
PEERFLIX_BASE_URL=https://peerflix.mov

# Credenciales usadas solo por src/fetch.mjs / GitHub Actions
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: clave API de TMDb para expandir temporadas
# (watchlist.txt acepta líneas "tt1234567:s1" que requieren esta clave)
TMDB_API_KEY=

# Timeouts y concurrencia
FETCH_TIMEOUT_MS=15000
FETCH_CONCURRENCY=4

# DRY_RUN=1 consulta y genera JSON, pero no escribe en Supabase
DRY_RUN=0
