# Todo es opcional: sin ninguna variable, `npm run fetch` consulta los addons,
# usa Cinemeta (sin API key) y publica los JSON en public/.

# Providers Stremio consultados por defecto (TPB Adult queda catalog-only)
PROVIDERS=peerflix,torrentsdb,torrentio,piratebay,ytztvio

# URL base de Peerflix (por defecto https://peerflix.mov)
PEERFLIX_BASE_URL=https://peerflix.mov

# Opcional: Supabase (solo src/fetch.mjs / GitHub Actions, nunca en la web)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# DRY_RUN=1 consulta y genera JSON, pero no escribe en Supabase
DRY_RUN=0

# Metadatos sin API key (Cinemeta): títulos, años y temporadas completas
# ("tt1234567:s1"). CINEMETA=0 los desactiva.
CINEMETA=1
# Opcional: TMDb y OMDb para descubrir estrenos/tendencias, guardar tmdb_id en
# Supabase y enriquecer/verificar títulos, años y temporadas
TMDB_API_KEY=
OMDB_API_KEY=

# Trackers por magnet: solo los mejores de ngosang/trackerslist (1-50)
MAX_TRACKERS=10
# Lista de trackers descargada en cada ejecución; vacío = usar la copia integrada
# TRACKERS_URL=https://raw.githubusercontent.com/ngosang/trackerslist/master/trackers_best.txt

# Timeouts, concurrencia y corte por addon (errores seguidos antes de dejar de consultarlo)
FETCH_TIMEOUT_MS=15000
FETCH_CONCURRENCY=4
BREAKER_THRESHOLD=3

# REPROCESS=1 vuelve a elegir los 2 torrents sobre public/data ya publicado (sin red)
# REPROCESS=0
