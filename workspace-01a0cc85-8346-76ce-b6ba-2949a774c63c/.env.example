# Run without writing to Supabase until you have checked the results.
DRY_RUN=true
TARGET_CRAWLERS=all
MAX_PAGES=3
REQUEST_TIMEOUT_MS=20000
CRAWLER_CONCURRENCY=2
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional domain overrides. Use only mirrors you trust.
WOLFTORRENT_BASE_URL=https://wolftorrent.com/
SINSITIO_BASE_URL=https://www.sinsitio.site/
# Normal browser download fallback when Wolf exposes only a JavaScript button.
# Requires: npx playwright install chromium
WOLFTORRENT_BROWSER=true
