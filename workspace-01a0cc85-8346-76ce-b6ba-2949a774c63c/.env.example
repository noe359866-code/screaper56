# ---------------------------------------------------------------------------
# Ejecución
# ---------------------------------------------------------------------------
# Ejecuta sin escribir en Supabase hasta que hayas revisado los resultados.
DRY_RUN=true
# all = las 13 fuentes; o una lista separada por comas (p. ej. "dontorrent,yts").
TARGET_CRAWLERS=all
MAX_PAGES=3
REQUEST_TIMEOUT_MS=20000
# Fuentes procesadas en paralelo por el orquestador.
CRAWLER_CONCURRENCY=2
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Observabilidad y límites globales de los crawlers
# ---------------------------------------------------------------------------
# error | warn | info | debug (por defecto info).
LOG_LEVEL=info
# Pausa de cortesía entre peticiones HTTP de un mismo crawler (ms, 0 = sin pausa).
CRAWLER_REQUEST_DELAY_MS=0
# Presupuesto de tiempo por crawler (ms, 0 = sin límite). Al agotarse, el
# crawler devuelve lo que ya haya recolectado en lugar de seguir paginando.
CRAWLER_TIME_BUDGET_MS=0
# Fichas de detalle descargadas en paralelo en los catálogos HTML compartidos.
CATALOG_DETAIL_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Dominios y espejos
# ---------------------------------------------------------------------------
# Cada fuente admite dos variables:
#   <NOMBRE>_BASE_URL  -> fuerza un único dominio (se prueba antes que nada).
#   <NOMBRE>_MIRRORS   -> lista separada por comas que sustituye a los espejos
#                         por defecto; se prueban en orden y se cachea el primero
#                         que responde con el marcador esperado.
# Usa solo dominios que tengas permiso para consultar.

# DonTorrent (nueva fuente)
DONTORRENT_BASE_URL=https://dontorrent.moi
# DONTORRENT_MIRRORS=https://dontorrent.moi,https://dontorrent.wtf
# Secciones a recorrer (peliculas, series, documentales, variados, musica, juegos).
# DONTORRENT_SECTIONS=peliculas,series
# Búsquedas adicionales enviadas a /buscar.
# DONTORRENT_SEARCH=castellano,latino
# Fichas de detalle en paralelo.
DONTORRENT_CONCURRENCY=2
# Hosts CDN aceptados para enlaces .torrent (además del propio dominio).
# DONTORRENT_CDN_HOSTS=doncdn.com
# Lee /dominios para ampliar la lista de espejos (activado por defecto;
# pon "false" para usar solo los dominios configurados aquí).
# DONTORRENT_DISCOVER_MIRRORS=true
# DONTORRENT_MAX_MIRROR_PROBES=10

# Wolftorrent
WOLFTORRENT_BASE_URL=https://wolftorrent.com
# WOLFTORRENT_MIRRORS=https://wolftorrent.com,https://wolfmax4k.com
# Fallback con navegador real cuando Wolf solo expone un botón JavaScript.
# Requiere: npx playwright install chromium
WOLFTORRENT_BROWSER=true

# Sinsitio
SINSITIO_BASE_URL=https://www.sinsitio.site
# SINSITIO_MIRRORS=https://www.sinsitio.site,https://sinsitio.site

# Resto de fuentes (descomenta solo lo que necesites sobreescribir)
# PELISPANDA_BASE_URL=https://pelispanda.org
# PELISPANDA_CONCURRENCY=3
# LEECH1337X_BASE_URL=https://1337x.la
# LEECH1337X_CONCURRENCY=2
# TORRENTGALAXY_MIRRORS=https://torrentgalaxy.to,https://tgx.rs
# YTS_BASE_URL=https://yts.mx
# EZTV_BASE_URL=https://eztv1.xyz
# THEPIRATEBAY_MIRRORS=https://thepiratebay10.org,https://tpb.party
# APIBAY_BASE_URL=https://apibay.org
# THEPIRATEBAY_SEARCH=spanish,castellano,latino
# NYAA_BASE_URL=https://nyaa.si
# ELITETORRENT_BASE_URL=https://www.elitetorrent.com
# ELITETORRENT_CONCURRENCY=5
# MEJORTORRENT_BASE_URL=https://www45.mejortorrent.eu
# MEJORTORRENT_CONCURRENCY=8
# LIMETORRENTS_BASE_URL=https://limetorrent.store
# LIMETORRENTS_CONCURRENCY=3
# LIMETORRENTS_SEARCH=spanish,castellano,latino
