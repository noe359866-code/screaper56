{
  "name": "peerflix-static",
  "version": "2.1.0",
  "description": "Static ingest UI + GitHub Action that aggregates Stremio addon streams and UPSERTs into the existing Supabase torrents table",
  "type": "module",
  "private": true,
  "scripts": {
    "fetch": "node src/fetch.mjs",
    "serve": "python3 -m http.server 4173 --directory public --bind 0.0.0.0",
    "dev": "npm run serve",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
